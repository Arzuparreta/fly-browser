docs/public/benchmarks/*.json linguist-generated=true

# Preserve upstream release bytes, including whitespace in filter lists and notices.
assets/extensions/ublock-origin/** linguist-vendored=true -whitespace
extension-api.preload.js linguist-generated=true

# Unified patches prefix an empty context line with one space. Validate their
# added source whitespace with git apply --whitespace=error-all instead.
chromium/patches/*.patch whitespace=-blank-at-eol

# Native overlay hashes, GN arguments and patch context must be identical on
# every host. Windows autocrlf conversion makes LF upstream patches fail.
chromium/** -text
