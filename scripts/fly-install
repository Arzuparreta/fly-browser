#!/usr/bin/env bash
# fly-install: install, update, inspect and uninstall native Chromium Fly on Linux.
# Usage: fly-install install [--package|--native]
#        fly-install update | status | uninstall [all|package|native] [--purge] [--yes]
# Electron is retained in legacy/electron; its profiles and binaries are kept.
set -euo pipefail
repo=Arzuparreta/fly-browser
config=${XDG_CONFIG_HOME:-$HOME/.config}
cache_home=${XDG_CACHE_HOME:-$HOME/.cache}
data=${XDG_DATA_HOME:-$HOME/.local/share}
target=$data/fly-browser
say() { printf '%s\n' "$*"; }
die() { say "fly-install: $*" >&2; exit 1; }
package_installed() { command -v pacman >/dev/null && pacman -Q fly-browser-bin >/dev/null 2>&1; }
install_native() (
    [ "$(uname -s)" = Linux ] && [ "$(uname -m)" = x86_64 ] || die 'Native packages currently support Linux x86_64 only.'
    cache=${XDG_CACHE_HOME:-$HOME/.cache}/fly-install
    mkdir -p "$cache"
    tmp=$(mktemp -d "$cache/native.XXXXXXXXXX")
    trap 'rm -rf "$tmp"' EXIT
    available=$(LC_ALL=C df -Pk "$tmp" | awk 'END {print $4}')
    [[ $available =~ ^[0-9]+$ ]] && [ "$available" -ge 2097152 ] || die 'At least 2 GiB free is needed in the installer cache; set XDG_CACHE_HOME to a disk with room.'
    export TMPDIR=$tmp BUILDDIR=$tmp
    curl -fsSL "https://api.github.com/repos/$repo/releases/latest" -o "$tmp/release.json"
    version=$(sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p' "$tmp/release.json" | head -n1)
    [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die 'Could not read a stable release tag.'
    base=https://github.com/$repo/releases/download/v$version
    name=Fly-$version-native-linux-x64.tar.gz
    curl -fsSL "$base/SHA256SUMS.txt" -o "$tmp/SHA256SUMS.txt"
    expected=$(awk -v name="$name" '$2 == name || $2 == "*" name {print $1}' "$tmp/SHA256SUMS.txt")
    [[ $expected =~ ^[a-f0-9]{64}$ ]] || die 'This release has no native Chromium package checksum; Electron was not installed.'
    if [ "$method" = package ]; then
        command -v makepkg >/dev/null || die 'The --package option needs makepkg on an Arch-based system.'
        curl -fsSL "$base/PKGBUILD" -o "$tmp/PKGBUILD"
        grep -Fq -- '-native-linux-x64.tar.gz' "$tmp/PKGBUILD" && grep -Fq -- "$expected" "$tmp/PKGBUILD" || die 'PKGBUILD does not match the native Chromium release.'
        (cd "$tmp" && makepkg -si)
        exit
    fi
    curl -fL "$base/$name" -o "$tmp/$name" || die 'This release has no native Chromium package; Electron was not installed. See docs/guide/installation.md.'
    actual=$(sha256sum "$tmp/$name"); actual=${actual%% *}
    [ "$expected" = "$actual" ] || die 'Native package checksum mismatch; installation was not changed.'
    tar -xzf "$tmp/$name" -C "$tmp"
    "$tmp/fly-browser/install.sh"
)
method=auto
case ${1:-status} in
    install|update|upgrade)
        command=${1}; shift
        for arg in "$@"; do
            case $arg in
                --native) method=native ;;
                --package) method=package ;;
                --appimage) die 'AppImage is Electron legacy. Use --native for Chromium.' ;;
                *) die "Unknown option: $arg" ;;
            esac
        done
        if package_installed; then method=package
        elif [ "$method" = auto ] && [ "$command" = install ] && command -v pacman >/dev/null && command -v makepkg >/dev/null; then method=package; fi
        install_native ;;
    status|scan|list)
        if [ -f "$target/VERSION" ]; then cat "$target/VERSION"; say "Installation: $target"; else say 'Native Fly is not installed for this user.'; fi
        if package_installed; then pacman -Q fly-browser-bin; fi
        for profile in "$config/fly-browser" "$config/fly-browser-flags.conf"; do
            [ ! -e "$profile" ] || say "Retained configuration: $profile"
        done
        say 'Electron legacy copies: use bash legacy/electron/fly-install status from the repository.' ;;
    uninstall|remove)
        shift
        scope=all
        yes=false
        purge=false
        for arg in "$@"; do
            case $arg in
                all|package|native) scope=$arg ;;
                --yes) yes=true ;;
                --purge) purge=true ;;
                *) die "Unknown uninstall option: $arg" ;;
            esac
        done
        if [ "$yes" = false ]; then
            detail='keeping profiles'
            [ "$purge" = false ] || detail='PERMANENTLY DELETING Fly profiles, history, passwords and settings'
            read -r -p "Remove Fly installation ($scope), $detail? [y/N] " answer
            [[ $answer = [yY] ]] || exit 1
        fi
        if [ "$scope" != native ] && package_installed; then
            if [ "$(id -u)" = 0 ]; then
                pacman -R --noconfirm fly-browser-bin
            else
                sudo pacman -R --noconfirm fly-browser-bin
            fi
        fi
        if [ "$scope" != package ]; then
            rm -rf "$target"
            for link in "$HOME/.local/bin/fly-browser"; do
                if [ "$(readlink "$link" 2>/dev/null || true)" = "$target/fly-browser" ]; then rm -f "$link"; fi
            done
            rm -f "$data/applications/fly-browser.desktop"
            for size in 48 128 256; do rm -f "$data/icons/hicolor/${size}x${size}/apps/fly-browser.png"; done
            command -v update-desktop-database >/dev/null && update-desktop-database "$data/applications" || true
        fi
        rm -rf "$cache_home/fly-install" "$cache_home/fly-browser"
        if [ "$purge" = true ]; then
            rm -rf "$config/fly-browser"
            rm -f "$config/fly-browser-flags.conf"
            say 'Removed Fly installation and profiles, including history, passwords and settings.'
        else
            say 'Removed Fly installation; native and Electron profiles are kept.'
        fi ;;
    help|--help|-h) sed -n '2,5s/^# //p' "$0" ;;
    *) die 'Use install, update, status or uninstall.' ;;
esac
