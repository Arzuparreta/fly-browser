#!/usr/bin/env bash
# fly-install: install, update, inspect and uninstall Fly on Linux.
# Usage: fly-install install [--package|--native]
#        fly-install update | status | uninstall [all|package|native] [--purge] [--yes]
set -euo pipefail
repo=Arzuparreta/fly-browser
config=${XDG_CONFIG_HOME:-$HOME/.config}
cache_home=${XDG_CACHE_HOME:-$HOME/.cache}
data=${XDG_DATA_HOME:-$HOME/.local/share}
target=$data/fly-browser
say() { printf '%s\n' "$*"; }
die() { say "fly-install: $*" >&2; exit 1; }
package_manager() {
    if command -v dpkg-query >/dev/null && dpkg-query -W -f='${Status}' fly-browser-bin 2>/dev/null | grep -q 'install ok installed'; then echo apt
    elif command -v rpm >/dev/null && rpm -q fly-browser-bin >/dev/null 2>&1; then
        if command -v zypper >/dev/null; then echo zypper; else echo dnf; fi
    elif command -v pacman >/dev/null && pacman -Q fly-browser-bin >/dev/null 2>&1; then echo pacman
    fi
}
package_installed() { [ -n "$(package_manager)" ]; }
as_root() { if [ "$(id -u)" = 0 ]; then "$@"; else sudo "$@"; fi; }
# Pinned release key, not a key downloaded beside an untrusted package.
release_key=''
release_key_armored=''
verify_release() {
    command -v gpgv >/dev/null || die 'Install gpgv (Debian/Ubuntu) or GnuPG, then retry.'
    printf '%s' "$release_key" | base64 -d > "$tmp/release-key.gpg"
    mkdir -m 700 "$tmp/gnupg"
    printf '%s' "$release_key_armored" | base64 -d > "$tmp/release-key.asc"
    curl -fsSL "$base/SHA256SUMS.txt.asc" -o "$tmp/SHA256SUMS.txt.asc" || die 'The release has no signature; nothing was installed.'
    gpgv --homedir "$tmp/gnupg" --keyring "$tmp/release-key.gpg" "$tmp/SHA256SUMS.txt.asc" "$tmp/SHA256SUMS.txt" || die 'Release signature verification failed; nothing was installed.'
}
install_native() (
    [ "$(uname -s)" = Linux ] && [ "$(uname -m)" = x86_64 ] || die 'Native packages currently support Linux x86_64 only.'
    cache=${XDG_CACHE_HOME:-$HOME/.cache}/fly-install
    mkdir -p "$cache"
    tmp=$(mktemp -d "$cache/native.XXXXXXXXXX")
    trap 'rm -rf "$tmp"' EXIT
    available=$(LC_ALL=C df -Pk "$tmp" | awk 'END {print $4}')
    [[ $available =~ ^[0-9]+$ ]] && [ "$available" -ge 2097152 ] || die 'At least 2 GiB free is needed in the installer cache; set XDG_CACHE_HOME to a disk with room.'
    export TMPDIR=$tmp BUILDDIR=$tmp
    curl -fsSL "https://api.github.com/repos/$repo/releases/latest" -o "$tmp/release.json"
    version=$(sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p' "$tmp/release.json" | head -n1)
    [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die 'Could not read a stable release tag.'
    base=https://github.com/$repo/releases/download/v$version
    name=Fly-$version-native-linux-x64.tar.gz
    curl -fsSL "$base/SHA256SUMS.txt" -o "$tmp/SHA256SUMS.txt"
    verify_release
    if [ -f "$target/VERSION" ]; then
        installed=$(sed -n 's/^Fly //p' "$target/VERSION")
        [ "$(printf '%s\n%s\n' "$installed" "$version" | sort -V | head -n1)" = "$installed" ] || die 'Refusing to downgrade the installed browser.'
    fi
    if [ "$method" = package ]; then
        [ ! -d "$target" ] || die 'Remove the user installation first with fly-install uninstall native --yes; your profile is kept.'
        if [ -e /run/ostree-booted ]; then die 'This is an immutable system; use the user installation.'; fi
        if command -v apt-get >/dev/null; then kind=deb
        elif command -v zypper >/dev/null; then kind=rpm
        elif command -v dnf >/dev/null; then kind=rpm
        elif command -v pacman >/dev/null; then kind=pkg.tar.zst
        else die 'No supported package manager; use --native.'; fi
        name=$(awk -v suffix=".$kind" 'index($2,"fly-browser-bin") == 1 && substr($2,length($2)-length(suffix)+1) == suffix {print $2; exit}' "$tmp/SHA256SUMS.txt")
        [ -n "$name" ] || die 'This release has no package for this system.'
    fi
    expected=$(awk -v name="$name" '$2 == name || $2 == "*" name {print $1}' "$tmp/SHA256SUMS.txt")
    [[ $expected =~ ^[a-f0-9]{64}$ ]] || die 'This release has no Linux package checksum; nothing was installed.'
    curl -fL "$base/$name" -o "$tmp/$name" || die 'This release has no Linux package; nothing was installed. See docs/guide/installation.md.'
    actual=$(sha256sum "$tmp/$name"); actual=${actual%% *}
    [ "$expected" = "$actual" ] || die 'Native package checksum mismatch; installation was not changed.'
    if [ "$method" = package ]; then
        case $kind in
            deb) as_root apt-get install "$tmp/$name" ;;
            rpm)
                as_root rpm --import "$tmp/release-key.asc"
                if command -v zypper >/dev/null; then as_root zypper --non-interactive install "$tmp/$name"
                else as_root dnf install "$tmp/$name"; fi ;;
            pkg.tar.zst)
                as_root pacman-key --add "$tmp/release-key.gpg"
                as_root pacman-key --lsign-key ED5C430691764316F98C1A8623274B1DFAB01ABE
                as_root pacman -U "$tmp/$name"
                if ! grep -Eq '^Include[[:space:]]*=[[:space:]]*/etc/pacman.d/fly-browser.conf[[:space:]]*$' /etc/pacman.conf; then
                    printf '\nInclude = /etc/pacman.d/fly-browser.conf\n' | as_root tee -a /etc/pacman.conf >/dev/null
                fi ;;
        esac
        exit
    fi
    tar -xzf "$tmp/$name" -C "$tmp"
    "$tmp/fly-browser/install.sh"
)
method=auto
case ${1:-status} in
    install|update|upgrade)
        operation=$1; shift
        for arg in "$@"; do
            case $arg in
                --native) method=native ;;
                --package) method=package ;;
                *) die "Unknown option: $arg" ;;
            esac
        done
        if package_installed && [ "$operation" != install ]; then
            case $(package_manager) in
                apt) as_root apt-get update; as_root apt-get install --only-upgrade fly-browser-bin ;;
                dnf) as_root dnf upgrade fly-browser-bin ;;
                zypper) as_root zypper update fly-browser-bin ;;
                pacman) as_root pacman -Syu fly-browser-bin ;;
            esac
            exit
        fi
        if package_installed; then method=package; fi
        install_native ;;
    status|scan|list)
        if [ -f "$target/VERSION" ]; then cat "$target/VERSION"; say "Installation: $target"; else say 'Fly is not installed for this user.'; fi
        if package_installed; then say "System package: fly-browser-bin ($(package_manager))"; fi
        for profile in "$config/fly-browser" "$config/fly-browser-flags.conf"; do
            [ ! -e "$profile" ] || say "Retained configuration: $profile"
        done ;;
    uninstall|remove)
        shift
        scope=all
        yes=false
        purge=false
        for arg in "$@"; do
            case $arg in
                all|package|native) scope=$arg ;;
                --yes) yes=true ;;
                --purge) purge=true ;;
                *) die "Unknown uninstall option: $arg" ;;
            esac
        done
        if [ "$yes" = false ]; then
            detail='keeping profiles'
            [ "$purge" = false ] || detail='PERMANENTLY DELETING Fly profiles, history, passwords and settings'
            read -r -p "Remove Fly installation ($scope), $detail? [y/N] " answer
            [[ $answer = [yY] ]] || exit 1
        fi
        if [ "$scope" != native ] && package_installed; then
            case $(package_manager) in
                apt) as_root apt-get purge --yes fly-browser-bin ;;
                dnf) as_root dnf remove --assumeyes fly-browser-bin ;;
                zypper) as_root zypper --non-interactive remove fly-browser-bin ;;
                pacman) as_root pacman -R --noconfirm fly-browser-bin ;;
            esac
        fi
        if [ "$scope" != package ]; then
            mkdir -p "$data"
            exec 9>"$target.lock"
            flock -n 9 || die 'Another Fly installation is in progress.'
            rm -rf "$target" "$target.old" "$target.new"
            link=$HOME/.local/bin/fly-browser
            if [ "$(readlink "$link" 2>/dev/null || true)" = "$target/fly-browser" ]; then rm -f "$link"; fi
            rm -f "$data/applications/fly-browser.desktop"
            for size in 48 128 256; do rm -f "$data/icons/hicolor/${size}x${size}/apps/fly-browser.png"; done
            command -v update-desktop-database >/dev/null && update-desktop-database "$data/applications" || true
        fi
        rm -rf "$cache_home/fly-install" "$cache_home/fly-browser"
        if [ "$purge" = true ]; then
            rm -rf "$config/fly-browser"
            rm -f "$config/fly-browser-flags.conf"
            say 'Removed Fly installation and profiles, including history, passwords and settings.'
        else
            say 'Removed Fly installation; profiles are kept.'
        fi ;;
    help|--help|-h) sed -n '2,4s/^# //p' "$0" ;;
    *) die 'Use install, update, status or uninstall.' ;;
esac
