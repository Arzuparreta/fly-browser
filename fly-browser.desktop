[Desktop Entry]
Name=Fly
Comment=Small, minimal web browser with full keyboard control and a polished mouse experience
Exec=fly-browser %u
Icon=fly-browser
Terminal=false
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=fly-browser
