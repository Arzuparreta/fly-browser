+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
+  // Fly's explicit application preference controls actual native web preferences.
+  // Keep internal WebUI, native enterprise policy and forced-colors semantics.
+  // Keep Chromium's effective profile, whether upstream passes it as a
+  // pointer (Stable) or a reference (Beta).
+  const Profile& fly_profile = [](const auto& current) -> const Profile& {
+    if constexpr (requires { current->GetPrefs(); }) {
+      return *current;
+    } else {
+      return current;
+    }
+  }(profile);
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("fly-native") &&
+      !security_principal.IsWebUI() &&
+      !fly_profile.IsEnterpriseIsolatedModeProfile() &&
+      !fly_profile.GetPrefs()->IsManagedPreference(prefs::kBrowserColorScheme) &&
+      ui::NativeTheme::GetInstanceForWeb()->forced_colors() ==
+          ui::ColorProviderKey::ForcedColors::kNone && g_browser_process) {
+    auto* state = g_browser_process->local_state();
+    if (state && state->FindPreference(fly::kPreferencesPref)) {
+      fly::PreferencesService preferences(*state);
+      if (const auto theme = preferences.ReadTheme()) {
+        preferred_color_scheme = fly::WebsiteUsesDarkTheme(*theme)
+            ? blink::mojom::PreferredColorScheme::kDark
+            : blink::mojom::PreferredColorScheme::kLight;
+        preferred_root_scrollbar_color_scheme = preferred_color_scheme;
+      }
+    }
+  }
+#endif
