+// Fly: native Fly runs Chromium's default features instead of the experiments
+// that testing/variations/fieldtrial_testing_config.json applies to unbranded
+// builds; its README asks browsers other than Chrome to disable it. Those
+// experiments cost memory, idle CPU and tab-switching time. Experiments that
+// already migrated profile data written by earlier Fly releases stay on, with
+// the stage those releases ran: localStorage and IndexedDB in SQLite and the
+// migrated search engine data. The Privacy Sandbox APIs that the config turned
+// off stay off. A feature named on the command line keeps the state given
+// there.
+void ApplyFlyFeatureDefaults(base::CommandLine* command_line) {
+  // variations::switches::kDisableFieldTrialTestingConfig
+  command_line->AppendSwitch("disable-field-trial-config");
+  const auto named = [&](std::string_view feature) {
+    for (const char* list : {switches::kEnableFeatures,
+                             switches::kDisableFeatures}) {
+      for (std::string_view entry :
+           base::SplitStringPiece(command_line->GetSwitchValueASCII(list), ",",
+                                  base::TRIM_WHITESPACE,
+                                  base::SPLIT_WANT_NONEMPTY)) {
+        if (entry.starts_with('*'))
+          entry.remove_prefix(1);
+        if (entry.substr(0, entry.find_first_of(":<")) == feature)
+          return true;
+      }
+    }
+    return false;
+  };
+  const auto add = [&](const char* list, std::string_view entry) {
+    if (named(entry.substr(0, entry.find(':'))))
+      return;
+    std::string value = command_line->GetSwitchValueASCII(list);
+    if (!value.empty())
+      value += ',';
+    value += entry;
+    command_line->AppendSwitchASCII(list, value);
+  };
+  add(switches::kEnableFeatures,
+      "DomStorageSqliteNewDatabases:DomStorageSqliteNewDatabasesStage/"
+      "UseSqliteForNewDatabases");
+  add(switches::kEnableFeatures,
+      "IdbSqliteOnDiskRollout:stage/UseSqliteForNewStores");
+  add(switches::kEnableFeatures, "PrepopulatedEnginesMigration");
+  add(switches::kEnableFeatures, "ApplySearchEngineTypeMigration");
+  for (const char* feature :
+       {"BrowsingTopics", "ConversionMeasurement", "Fledge",
+        "AdInterestGroupAPI", "SharedStorageAPI"})
+    add(switches::kDisableFeatures, feature);
+}
+#endif  // !defined(BUILDING_CHROME_RENDERER)
