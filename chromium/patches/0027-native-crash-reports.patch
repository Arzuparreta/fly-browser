--- a/chrome/app/chrome_crash_reporter_client.cc
+++ b/chrome/app/chrome_crash_reporter_client.cc
@@ -126,6 +126,17 @@
 
 bool ChromeCrashReporterClient::GetCrashDumpLocation(
     base::FilePath* crash_dir) {
+  // Fly: native Fly keeps crash reports with its own data instead of
+  // Chromium's default directory (~/.config/chromium).
+  const auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch("fly-native") &&
+      command_line->HasSwitch("user-data-dir")) {
+    const auto user_data = command_line->GetSwitchValuePath("user-data-dir");
+    if (user_data.IsAbsolute()) {
+      *crash_dir = user_data.Append(FILE_PATH_LITERAL("Crash Reports"));
+      return true;
+    }
+  }
   return base::PathService::Get(chrome::DIR_CRASH_DUMPS, crash_dir);
 }
 
