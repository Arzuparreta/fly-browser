+TEST_F(CacheUtilTest, FlyHttpCacheBackendUsesCeilingUnlessSizeIsExplicit) {
+  for (const auto size : {base::ByteSize(0), base::MiB(64), base::MiB(512)}) {
+    base::test::TestFuture<BackendResult> ready;
+    auto result = CreateCacheBackend(net::DISK_CACHE, net::CACHE_BACKEND_SIMPLE,
+                                     nullptr, cache_dir_, size.InBytes(),
+                                     ResetHandling::kNeverReset, nullptr,
+                                     nullptr, ready.GetCallback());
+    if (result.net_error == net::ERR_IO_PENDING)
+      result = ready.Take();
+    ASSERT_EQ(net::OK, result.net_error);
+    ASSERT_TRUE(result.backend);
+    const auto expected = size == base::ByteSize(0)
+                              ? PreferredCacheSizeForPath(cache_dir_)
+                              : size;
+    EXPECT_EQ(expected, result.backend->GetMaxBytesForTesting());
+    if (size == base::ByteSize(0))
+      EXPECT_LE(expected, base::MiB(256));
+    result.backend.reset();
+    FlushCacheThreadForTesting();
+  }
+}
