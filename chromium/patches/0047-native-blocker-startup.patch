+namespace {
+// Fly: see FileBackedRulesetSource::SetIndexedRulesetDirectory().
+base::Lock& IndexedRulesetDirectoryLock() {
+  static base::NoDestructor<base::Lock> lock;
+  return *lock;
+}
+std::map<ExtensionId, base::FilePath>& IndexedRulesetDirectories() {
+  static base::NoDestructor<std::map<ExtensionId, base::FilePath>> directories;
+  return *directories;
+}
+base::FilePath IndexedRulesetBase(const Extension& extension) {
+  base::AutoLock lock(IndexedRulesetDirectoryLock());
+  const auto& directories = IndexedRulesetDirectories();
+  const auto it = directories.find(extension.id());
+  return it == directories.end() ? extension.path() : it->second;
+}
+}  // namespace
+
+// static
+void FileBackedRulesetSource::SetIndexedRulesetDirectory(
+    const ExtensionId& extension_id,
+    const base::FilePath& directory) {
+  base::AutoLock lock(IndexedRulesetDirectoryLock());
+  IndexedRulesetDirectories()[extension_id] = directory;
+}
