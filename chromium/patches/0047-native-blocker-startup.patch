+void RulesMonitorService::FinishInitialLoad(
+    const ExtensionId& extension_id,
+    const base::Token& load_request_id) {
+  // A load invalidated by an unload was already finished there.
+  const auto it = pending_initial_loads_.find(extension_id);
+  if (load_request_id.is_zero() || it == pending_initial_loads_.end() ||
+      !it->second.erase(load_request_id)) {
+    return;
+  }
+  if (!it->second.empty()) {
+    return;
+  }
+  pending_initial_loads_.erase(it);
+  for (auto& observer : initial_load_observers_) {
+    observer.OnInitialRulesetsLoaded(extension_id);
+  }
+}
