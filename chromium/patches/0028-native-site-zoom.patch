 void Zoom(BrowserWindowInterface* browser, content::PageZoom zoom) {
+  // Fly: Electron's zoom steps (0.5 levels), shared per hostname by
+  // fly::SiteZoom across workspaces; also reached by Ctrl+wheel.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("fly-native")) {
+    fly::SiteZoom::Change(
+        browser->GetTabStripModel()->GetActiveWebContents(),
+        zoom == content::PAGE_ZOOM_IN    ? "zoom-in"
+        : zoom == content::PAGE_ZOOM_OUT ? "zoom-out"
+                                         : "reset-zoom");
+    return;
+  }
   zoom::PageZoom::Zoom(browser->GetTabStripModel()->GetActiveWebContents(),
                        zoom);
 }
