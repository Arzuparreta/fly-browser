 views::Widget* ChromeWebContentsViewFocusHelper::GetTopLevelWidget() {
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
+  // Native Fly browsers share an OS window but keep independent FocusManagers.
+  // This lower-level target cannot depend on the outer browser UI controller.
+  // The development gate and normal-window type identify the embedded browser.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("fly-native")) {
+    if (auto* tab = tabs::TabInterface::MaybeGetFromContents(&GetWebContents())) {
+      auto* browser = tab->GetBrowserWindowInterface();
+      if (browser && browser->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL &&
+          browser->GetWindow()) {
+        return views::Widget::GetWidgetForNativeView(
+            browser->GetWindow()->GetNativeWindow());
+      }
+    }
+  }
+#endif
   return views::Widget::GetTopLevelWidgetForNativeView(GetActiveNativeView());
 }
 
