+bool WebFrameWidgetImpl::ExecuteFlyPageScroll(const String& command) {
+  const bool down = command == "FlyScrollStepDown";
+  const bool up = command == "FlyScrollStepUp";
+  const bool left = command == "FlyScrollStepLeft";
+  const bool right = command == "FlyScrollStepRight";
+  const bool half_down = command == "FlyScrollHalfPageDown";
+  const bool half_up = command == "FlyScrollHalfPageUp";
+  const bool top = command == "FlyScrollTop";
+  const bool bottom = command == "FlyScrollBottom";
+  if (!(down || up || left || right || half_down || half_up || top || bottom))
+    return false;
+  LocalFrame* frame = FocusedLocalFrameInWidget();
+  if (!frame || !frame->GetDocument() || !frame->View())
+    return true;
+  Document* document = frame->GetDocument();
+  document->UpdateStyleAndLayout(DocumentUpdateReason::kScroll);
+  if (!frame->View() || frame->GetDocument() != document)
+    return true;
+
+  // Match Fly's focused scroll-container semantics, including shadow trees.
+  // Reading the native layout avoids serializing DOM state to the browser.
+  Element* target = nullptr;
+  for (Element* element = document->FocusedElement();
+       element && element != document->body() &&
+       element != document->documentElement();
+       element = FlatTreeTraversal::ParentElement(*element)) {
+    auto* box = element->GetLayoutBox();
+    auto* area = box ? box->GetScrollableArea() : nullptr;
+    if (area && area->MaximumScrollOffset() != area->MinimumScrollOffset() &&
+        (area->UserInputScrollable(kHorizontalScrollbar) ||
+         area->UserInputScrollable(kVerticalScrollbar))) {
+      target = element;
+      break;
+    }
+  }
+  if (!target)
+    target = document->ScrollingElementNoLayout();
+  auto* window = frame->DomWindow();
+  if (!target && !window)
+    return true;
+  auto* options = ScrollToOptions::Create();
+  options->setBehavior(V8ScrollBehavior::Enum::kSmooth);
+  double x = left ? -80 : right ? 80 : 0;
+  double y = down ? 80 : up ? -80 : 0;
+  if (half_down || half_up) {
+    const double height = target && target->clientHeight()
+                              ? target->clientHeight()
+                          : window ? window->innerHeight()
+                                   : 0;
+    y = std::floor(height / 2) * (half_down ? 1 : -1);
+  }
+  if (top || bottom) {
+    x = 0;
+    y = bottom && target ? target->scrollHeight() : 0;
+  }
+  options->setLeft(x);
+  options->setTop(y);
+  // Call Blink's implementations directly. Page overrides of scrollBy/scrollTo
+  // do not intercept browser controls; native zoom, snapping and smooth-scroll
+  // completion follow the same paths as the retained product's DOM commands.
+  if (target) {
+    if (top || bottom)
+      target->scrollTo(nullptr, options);
+    else if (left || right || half_down || half_up) {
+      target->scrollBy(nullptr, options);
+    } else {
+      auto* box = target->GetLayoutBox();
+      ScrollableArea* area = target == document->ScrollingElementNoLayout()
+                                 ? frame->View()->LayoutViewport()
+                                 : box ? box->GetScrollableArea() : nullptr;
+      const double zoom = target == document->ScrollingElementNoLayout()
+                              ? frame->LayoutZoomFactor()
+                              : box ? box->StyleRef().EffectiveZoom() : 1;
+      if (area)
+        area->UserScroll(ui::ScrollGranularity::kScrollByPixel,
+                         ScrollOffset(x * zoom, y * zoom),
+                         cc::ScrollSourceType::kRelativeScroll,
+                         BindOnce([](WeakPersistent<ScrollableArea> area,
+                                     ScrollableArea::ScrollCompletionMode mode) {
+                           if (area)
+                             area->OnScrollFinished(mode ==
+                                 ScrollableArea::ScrollCompletionMode::kFinished);
+                         }, WrapWeakPersistent(area)));
+    }
+  } else {
+    if (top || bottom)
+      window->scrollTo(nullptr, options);
+    else
+      window->scrollBy(nullptr, options);
+  }
+  return true;
+}
