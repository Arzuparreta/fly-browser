--- a/chrome/browser/ui/views/frame/browser_view.cc
+++ b/chrome/browser/ui/views/frame/browser_view.cc
@@ -1062,7 +1062,15 @@
                           base::Unretained(this), CanFullscreen()));
   UpdateFullscreenAllowedFromPolicy(CanFullscreen());
 
-  WebUIContentsPreloadManager::GetInstance()->WarmupForBrowser(browser_.get());
+  // Fly supplies its own native surfaces. Keep Chromium's preloading for
+  // windows whose controls still belong to Chromium.
+  bool fly_window = false;
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
+  fly_window = fly::FlyWindowController::ShouldDecorate(browser_.get());
+#endif
+  if (!fly_window) {
+    WebUIContentsPreloadManager::GetInstance()->WarmupForBrowser(browser_.get());
+  }
 
   browser_->GetFeatures().InitPostBrowserViewConstruction(this);
 
--- a/chrome/browser/ui/views/location_bar/location_bar_view.cc
+++ b/chrome/browser/ui/views/location_bar/location_bar_view.cc
@@ -4,6 +4,10 @@
 
 #include "chrome/browser/ui/views/location_bar/location_bar_view.h"
 
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
+#include "fly/ui/fly_window_controller.h"
+#endif
+
 #include <algorithm>
 #include <memory>
 #include <ranges>
@@ -197,6 +201,13 @@
   if (!browser) {
     return true;
   }
+  // The hidden Chromium location bar in a decorated Fly window never opens
+  // these WebUIs. Retain the native fallback and all other window types.
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
+  if (fly::FlyWindowController::ShouldDecorate(browser)) {
+    return false;
+  }
+#endif
   return !web_app::AppBrowserController::IsWebApp(browser) &&
          browser->GetType() != BrowserWindowInterface::Type::TYPE_DEVTOOLS;
 }
