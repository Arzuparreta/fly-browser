# Fly Browser's native services. Upstream browser UI glue is compiled in the
# existing chrome/browser/ui target to avoid introducing a circular dependency.
import("//testing/test.gni")

source_set("pref_storage") {
  sources = [ "prefs/dictionary_store.h" ]
  public_deps = [
    "//base",
    "//components/prefs",
  ]
}

source_set("workspaces") {
  sources = [
    "workspaces/workspace_service.cc",
    "workspaces/workspace_service.h",
  ]
  public_deps = [
    "//base",
    "//components/prefs",
  ]
  deps = [ ":pref_storage" ]
}

source_set("commands") {
  sources = [
    "commands/calculator.cc",
    "commands/calculator.h",
    "commands/command_service.cc",
    "commands/command_service.h",
    "commands/generated_contract.h",
    "commands/hint_codes.cc",
    "commands/hint_codes.h",
    "commands/keyboard_config.cc",
    "commands/keyboard_config.h",
    "commands/keyboard_router.cc",
    "commands/keyboard_router.h",
    "commands/palette_catalog.cc",
    "commands/palette_catalog.h",
  ]
  public_deps = [
    "//base",
    "//components/prefs",
  ]
  deps = [
    ":pref_storage",
    "//third_party/icu",
  ]
}

source_set("preferences") {
  sources = [
    "preferences/preferences_service.cc",
    "preferences/preferences_service.h",
    "preferences/search_service.cc",
    "preferences/search_service.h",
  ]
  public_deps = [
    "//base",
    "//components/prefs",
  ]
  deps = [
    ":pref_storage",
    "//components/url_formatter",
  ]
  public_deps += [ "//url" ]
}

source_set("bookmarks") {
  sources = [
    "bookmarks/bookmark_service.cc",
    "bookmarks/bookmark_service.h",
    "bookmarks/frequent_sites_service.cc",
    "bookmarks/frequent_sites_service.h",
  ]
  public_deps = [ "//base" ]
  deps = [
    ":pref_storage",
    ":preferences",
    "//components/prefs",
    "//url",
  ]
}

source_set("legacy_import") {
  sources = [
    "import/legacy_import.cc",
    "import/legacy_import.h",
  ]
  public_deps = [
    ":commands",
    "//base",
  ]
  deps = [
    ":bookmarks",
    ":preferences",
    ":workspaces",
    "//components/prefs",
  ]
}

source_set("session_metadata") {
  sources = [
    "sessions/tab_identity.cc",
    "sessions/tab_identity.h",
    "sessions/tab_move_gate.cc",
    "sessions/tab_move_gate.h",
  ]
  public_deps = [
    "//base",
    "//content/public/browser",
  ]
}

# Included by chrome/app/chrome_main_delegate.cc (0037-native-feature-defaults).
source_set("feature_defaults") {
  sources = [ "app/feature_defaults.h" ]
  deps = [ "//base" ]
}

test("fly_unittests") {
  sources = [
    "app/feature_defaults_unittest.cc",
    "bookmarks/bookmark_service_unittest.cc",
    "bookmarks/frequent_sites_service_unittest.cc",
    "commands/calculator_unittest.cc",
    "commands/command_service_unittest.cc",
    "commands/hint_codes_unittest.cc",
    "commands/keyboard_config_unittest.cc",
    "commands/palette_catalog_unittest.cc",
    "import/legacy_import_unittest.cc",
    "preferences/preferences_service_unittest.cc",
    "preferences/search_service_unittest.cc",
    "workspaces/workspace_service_unittest.cc",
  ]
  deps = [
    ":bookmarks",
    ":commands",
    ":feature_defaults",
    ":legacy_import",
    ":preferences",
    ":workspaces",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//components/prefs:test_support",
    "//testing/gtest",
  ]
}

# Same upstream in-process browser and out-of-process test launcher, scoped to
# Fly's acceptance cases. Keep the upstream browser_tests integration available
# for broader regressions without compiling its entire catalogue for each run.
if (is_linux || is_win) {
  test("fly_browser_tests") {
    use_xvfb = is_linux
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [ "test/workspace_browser_test.cc" ]
    deps = [
      ":bookmarks",
      ":commands",
      ":preferences",
      ":session_metadata",
      ":workspaces",
      "//base",
      "//base/test:test_support",
      "//base/version_info",
      "//chrome:packed_resources",
      "//chrome:resources",
      "//chrome:strings",
      "//chrome/browser",
      "//chrome/browser:browser_process",
      "//chrome/browser/bookmarks",
      "//chrome/browser/devtools",
      "//chrome/browser/extensions",
      "//chrome/browser/extensions:test_support",
      "//chrome/browser/history",
      "//components/history/core/common",
      "//components/services/storage:storage_features",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/profiles:profile_manager",
      "//chrome/browser/profiles/keep_alive",
      "//chrome/browser/profiles:profile_test_util",
      "//chrome/browser/resource_coordinator",
      "//chrome/browser/ssl",
      "//chrome/browser/ui",
      "//chrome/browser/ui/browser_window",
      "//chrome/browser/ui/browser_window:create_browser_window",
      "//chrome/browser/ui/tabs:tab_strip",
      "//chrome/renderer",
      "//chrome/test:test_support",
      "//chrome/test/base:browser_tests_runner",
      "//chrome/test/base:in_process_browser_test",
      "//chrome/test/base:ui_test_utils",
      "//components/javascript_dialogs",
      "//components/content_settings/core/browser",
      "//components/dom_distiller/core",
      "//components/performance_manager",
      "//components/password_manager/core/common",
      "//components/signin/public/base",
      "//content/public/browser",
      "//content/test:test_support",
      "//extensions:test_support",
      "//extensions/browser:test_support",
      "//net:test_support",
      "//testing/gtest",
      "//crypto",
      "//third_party/zlib/google:zip",
      "//ui/gfx/x",
      "//ui/aura",
      "//ui/base",
      "//ui/events:test_support",
      "//ui/views",
      "//ui/views:test_support",
      "//ui/wm",
    ]
    data_deps = [
      "//chrome",
      "//chrome:browser_tests_pak",
    ]
    data = [
      "//chrome/test/data/title1.html",
      "//chrome/test/data/favicon/page_with_favicon.html",
      "//chrome/test/data/favicon/icon.png",
      "//chrome/test/data/dom_distiller/simple_article.html",
    ]
  }
}

# Product fonts used by the native interface (IBM Plex and Doto, SIL OFL 1.1).
# RegisterFlyFonts() adds this directory to the browser's fontconfig.
copy("fonts") {
  sources = [
    "resources/fonts/Doto.ttf",
    "resources/fonts/IBMPlexMono-Medium.ttf",
    "resources/fonts/IBMPlexMono-Regular.ttf",
    "resources/fonts/IBMPlexSans.ttf",
    "resources/fonts/doto-OFL.txt",
    "resources/fonts/ibmplexmono-OFL.txt",
    "resources/fonts/ibmplexsans-OFL.txt",
  ]
  outputs = [ "$root_out_dir/fly_fonts/{{source_file_part}}" ]
}

# The Fly User Content extension's fixed files; native Fly copies them into
# <user data>/fly-user-content together with the generated content.js.
# Files the native browser reads at run time from <out>/fly_resources.
group("user_content_resources") {
  deps = [
    ":identity_resources",
    ":new_tab_fonts",
    ":new_tab_identity",
    ":new_tab_page",
    ":reader_resources",
    ":user_content_worker",
  ]
}

# Electron Fly's reader, copied by scripts/chromium/sync-resources.js.
copy("reader_resources") {
  sources = [ "resources/reader/readerDistiller.js" ]
  outputs = [ "$root_out_dir/fly_resources/reader/{{source_file_part}}" ]
}

# The product logo of the empty workspace view and the sidebar's engravings
# and paper grain.
copy("identity_resources") {
  sources = [
    "resources/identity/engraving-chasis@2x.png",
    "resources/identity/engraving-papel@2x.png",
    "resources/identity/icon-128.png",
    "resources/identity/paper-grain.png",
  ]
  outputs = [ "$root_out_dir/fly_resources/identity/{{source_file_part}}" ]
}

# Fly's new tab page (chrome://fly-new-tab), with Electron's fonts and
# artwork copied by scripts/chromium/sync-resources.js.
copy("new_tab_page") {
  sources = [
    "resources/new_tab/new-tab.css",
    "resources/new_tab/new-tab.html",
    "resources/new_tab/new-tab.js",
  ]
  outputs = [ "$root_out_dir/fly_resources/new_tab/{{source_file_part}}" ]
}
copy("new_tab_fonts") {
  sources = [
    "resources/new_tab/fonts/doto-0.woff2",
    "resources/new_tab/fonts/fonts.css",
    "resources/new_tab/fonts/plex-mono-0.woff2",
    "resources/new_tab/fonts/plex-mono-1.woff2",
    "resources/new_tab/fonts/plex-mono-2.woff2",
    "resources/new_tab/fonts/plex-sans-0.woff2",
    "resources/new_tab/fonts/plex-sans-1.woff2",
    "resources/new_tab/fonts/plex-sans-2.woff2",
  ]
  outputs = [ "$root_out_dir/fly_resources/new_tab/fonts/{{source_file_part}}" ]
}
copy("new_tab_identity") {
  sources = [
    "resources/new_tab/identity/memory-chasis@2x.png",
    "resources/new_tab/identity/memory-papel@2x.png",
    "resources/new_tab/identity/paper-grain.png",
    "resources/new_tab/identity/pixel-32.png",
  ]
  outputs =
      [ "$root_out_dir/fly_resources/new_tab/identity/{{source_file_part}}" ]
}

copy("user_content_worker") {
  sources = [
    "resources/user_content/background.js",
    "resources/user_content/manifest.json",
    "resources/user_content/offscreen.html",
    "resources/user_content/offscreen.js",
  ]
  outputs = [ "$root_out_dir/fly_resources/user_content/{{source_file_part}}" ]
}
