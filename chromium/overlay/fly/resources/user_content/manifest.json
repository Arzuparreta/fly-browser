{
  "manifest_version": 3,
  "name": "Fly User Content",
  "description": "Runs the user scripts and styles from Fly's scripts and styles folders.",
  "version": "1",
  "key": "",
  "minimum_chrome_version": "138",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "userScripts",
    "storage",
    "unlimitedStorage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "incognito": "split"
}
