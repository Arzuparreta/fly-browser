# Unmodified Chromium control. No credentials or remote execution service.
is_debug = false
is_component_build = true
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
use_remoteexec = false
use_siso = true
# Real H264/AAC decode in both the source-unmodified control and native Fly.
# This selects FFmpeg codecs; it does not enable Google product branding.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
# Widevine: the browser loads Google's CDM, which the component updater
# downloads into the user data directory. Fly never ships the CDM itself.
enable_widevine = true
