# Native Fly release build, used for packages. Same engine options as the
# development builds (control.gnargs), linked statically and without DCHECKs,
# which development builds keep on to catch mistakes early.
is_debug = false
is_component_build = false
dcheck_always_on = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
use_remoteexec = false
use_siso = true
proprietary_codecs = true
ffmpeg_branding = "Chrome"
# Widevine: the browser loads Google's CDM, which the component updater
# downloads into the user data directory. Fly never ships the CDM itself.
enable_widevine = true
# release.py fetches the Linux profile named by the pinned Chromium checkout.
chrome_pgo_phase = 2
use_mold = false
use_lld = true
use_thin_lto = true
thin_lto_enable_optimizations = true
# Packages start the browser directly (fly-browser), without a launcher script
# passing --fly-native.
fly_native_by_default = true
